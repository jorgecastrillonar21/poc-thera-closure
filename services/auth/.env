# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=theraclosure
DB_PASSWORD=password123
DB_NAME=theraclosure_auth
DB_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=168h

# AWS Cognito Configuration
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_abcdefg
AWS_COGNITO_CLIENT_ID=1234567890abcdefghijklmnop
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Server Configuration
SERVER_PORT=3001
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# Application Configuration
APP_NAME=theraclosure-auth-service
APP_VERSION=1.0.0
LOG_LEVEL=debug